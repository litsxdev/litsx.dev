{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@litsx/core",
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "website/docs/.vitepress/**/*.ts",
    "website/docs/.vitepress/**/*.tsx"
  ],
  "exclude": [
    "**/dist/**",
    "**/.vitepress/cache/**"
  ]
}
